{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cli": {
      "type": "object",
      "properties": {
        "scripts": {
          "type": "object",
          "properties": {
            "add": {
              "type": "string"
            },
            "addDev": {
              "type": "string"
            },
            "uninstall": {
              "type": "string"
            },
            "upgrade": {
              "type": "string"
            }
          },
          "required": ["add", "addDev", "uninstall", "upgrade"],
          "additionalProperties": false
        },
        "cache": {
          "default": true,
          "type": "boolean"
        },
        "cacheDir": {
          "default": "/Users/samuel/Coding/hulla/cli/.hulla/.cache",
          "type": "string"
        },
        "logs": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": ["scripts", "cache", "cacheDir", "logs"],
      "additionalProperties": false
    },
    "configs": {
      "default": {
        "api": "api.config.ts",
        "ui": ".hulla/ui.json"
      },
      "type": "object",
      "properties": {
        "api": {
          "default": "api.config.ts",
          "type": "string"
        },
        "ui": {
          "default": ".hulla/ui.json",
          "type": "string"
        }
      },
      "required": ["api", "ui"],
      "additionalProperties": false
    }
  },
  "required": ["cli", "configs"],
  "additionalProperties": false,
  "title": "Hulla Config Schema",
  "description": "Configuration schema for Hulla CLI tool"
}
